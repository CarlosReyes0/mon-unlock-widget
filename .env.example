# Privy app ID from https://dashboard.privy.io
# Allowlist https://openpaywall.app, https://www.openpaywall.app, and localhost for dev.
# Enable embedded wallets + Coinbase on-ramp funding for Monad (chain id 143).
# Enable USDC funding on Monad (checkout can buy USDC and swap to MON).
# Note: MoonPay and Ramp are unavailable in Texas — checkout prefers Coinbase Onramp.
VITE_PRIVY_APP_ID=

# WalletConnect Cloud project ID — mobile wallet connections (widget + publisher Privy auth).
# Default matches generator/dashboard embeds; override only if you use a different WC project.
VITE_WALLETCONNECT_PROJECT_ID=c2a289e11ad2998f8ea4633db536334c

# Stripe — fiat Apple Pay / Google Pay / card unlock (primary for non-crypto readers).
# Publishable key is safe in the browser; secret + webhook stay on Railway only.
# Verify openpaywall.app and www.openpaywall.app for Apple Pay in Stripe Dashboard → Settings → Payment methods.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional platform fee in basis points (100 = 1%). Used by fiat unlocks + Connect sample checkout.
# STRIPE_PLATFORM_FEE_BPS=1000
# Secret for POST /api/stripe/payouts/process (Railway cron / manual ops). Required in production.
STRIPE_PAYOUT_CRON_SECRET=
# Moderator hide for article aggregator: POST /api/listings/hide with Bearer token.
# Used by /admin-listings.html. Optional until you need to hide spam.
# Also set this SAME value as a Supabase Edge Function secret. update-listing
# accepts it as x-listing-admin-secret. Dashboard listing edits do not use it;
# the publisher wallet signs an "Open Paywall listing v1" message instead.
# Do not rotate a live value from this file — generate once and copy it into
# Railway and Supabase. Generate: openssl rand -base64 32
LISTING_ADMIN_SECRET=

# Indexer edge function shared secret. Strangers must not be able to trigger indexing.
# Set the SAME value in all three places (do not commit the real value):
#   1. Supabase → Edge Functions → Secrets → INDEXER_SECRET
#   2. Supabase Vault, name indexer_secret (pg_cron reads it; see
#      supabase/migrations/20260928143000_indexer_cron_secret.sql)
#   3. Railway cron service (cron/) env INDEXER_SECRET
#      The service start command must include --allow-env=INDEXER_SECRET
#      (see cron/railway.toml). Deno refuses the read otherwise.
# The cron sends it as x-indexer-secret and still sends the public anon JWT
# as Authorization so verify_jwt can stay on. Generate: openssl rand -base64 32
INDEXER_SECRET=

# Server-side register-article (Railway agent publish, OpenClaw).
# Browser Write does not use this — the connected wallet signs
# "Open Paywall publish v1" over the article payload.
# Set the SAME value as a Supabase Edge Function secret AND on the Railway
# web service. The server sends it as x-publish-secret. Generate: openssl rand -base64 32
REGISTER_PUBLISH_SECRET=
# Thin webhook signing secret for Accounts v2 Connect sample (/api/connect-sample/webhook).
# STRIPE_CONNECT_WEBHOOK_SECRET=

# Supabase (server) — required for Stripe entitlements + payout queue.
# Same project as article-body / indexer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional HMAC key for reader sessions (POST /api/reader/session).
# When unset, the server and the article-body edge function both fall back
# to SUPABASE_SERVICE_ROLE_KEY, which they already share. Set this only if
# you set the SAME value on Railway and as a Supabase Edge Function secret.
# Generate: openssl rand -base64 32
# READER_SESSION_SECRET=
# /write file hosting. With both Supabase vars set, photos/audio/video go to the
# public Storage bucket `article-media` (created on first upload, or apply
# supabase/migrations/0012_article_media_bucket.sql). Without them, files are
# stored on local disk and do not survive a Railway restart.
# MEDIA_DIR=

# Optional: Ramp Network host API key (https://docs.rampnetwork.com/web/quick-start-hosted).
# Kept as a fallback for regions where Ramp works; Texas readers use Coinbase instead.
VITE_RAMP_HOST_API_KEY=

# Coinbase Developer Platform — Secret API Key (server-only, Railway runtime env).
# Required for Texas / Coinbase Onramp session tokens (POST /api/coinbase/session-token).
# Create at https://portal.cdp.coinbase.com → API Keys → Secret API Keys (Ed25519).
# Do NOT put these in VITE_* — they must never ship to the browser.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional override for where /unlock.html is hosted (defaults to production CDN).
# VITE_CHECKOUT_ORIGIN=https://openpaywall.app

# Optional public origin for Open Graph / Twitter Card absolute URLs.
# Host still comes from the request; this only supplies the protocol when
# x-forwarded-proto is missing AND the Host header matches this origin.
# openpaywall.app, www.openpaywall.app, and *.up.railway.app are inferred
# as https without this.
# PUBLIC_ORIGIN=https://openpaywall.app

# Embed script origin for agent-generated snippets. Defaults to
# https://openpaywall.app when unset. Set this if a deploy override is present.
# CDN_BASE=https://openpaywall.app

# Machine Payments Protocol — agent publish API (POST /api/agents/publish).
# Generate secret: openssl rand -base64 32
# MPP_SECRET_KEY=
# Tempo recipient wallet (receives pathUSD charges from agents)
# MPP_TEMPO_RECIPIENT=0xYourWallet
# Optional: charge amount in pathUSD (default 0.05)
# MPP_PUBLISH_AMOUNT=0.05
# Challenge realm — must match the public host (mppscan requirement).
# Order: MPP_REALM, RAILWAY_PUBLIC_DOMAIN, PUBLIC_URL / VITE_CHECKOUT_ORIGIN
# host, else openpaywall.app. Railway sets RAILWAY_PUBLIC_DOMAIN to the
# *.up.railway.app hostname, which overrides the code default. Set this on
# the production service:
# MPP_REALM=openpaywall.app
# Local tests only — skip 402 payment gate
# MPP_DEV_BYPASS=1

# x402 (Bankr / agent wallets) — USDC on Base. Human reader unlock stays USDC on Monad.
# Recipient defaults to MPP_TEMPO_RECIPIENT if unset (same 0x works on Base).
# X402_PAY_TO=0xYourWallet
# Optional facilitator (default: CDP x402 if CDP keys are set, else PayAI).
# X402_FACILITATOR_URL=https://facilitator.payai.network
# Optional: publish charge in USD (default MPP_PUBLISH_AMOUNT / 0.05)
# X402_PUBLISH_AMOUNT=0.05
# Optional: unlock fallback USD when a listing is not USDC-priced (default 0.50)
# X402_UNLOCK_AMOUNT=0.50
# Local tests only — skip x402 payment gate
# X402_DEV_BYPASS=1

# Optional: MiroShark “how might this land?” (x402aff affiliate)
# Get a Builder Code at https://dashboard.base.org or https://base.dev →
# Settings → Builder Codes (looks like bc_b7k3p9da). Do NOT invent a code and
# do NOT reuse the homepage base:app_id meta (6aab87b69b238d5ecd11e976) —
# that tag is only for Base domain verify on articles.html.
# Missing/invalid BASE_BUILDER_CODE disables the Write panel with clear copy.
# BASE_BUILDER_CODE=bc_yourcode
# Optional override (default https://x402.miroshark.xyz)
# MIROSHARK_BASE_URL=https://x402.miroshark.xyz
# Optional server-side $1 USDC payer for the spike (Base wallet). Production
# can omit this and return the x402 402 challenge to a client wallet instead.
# MIROSHARK_X402_PRIVATE_KEY=0x...

# Optional: voice-style social drafts on /write (never auto-posts).
# Preferred key; falls back to OPENAI_API_KEY or ANTHROPIC_API_KEY.
# VOICE_DRAFT_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# VOICE_DRAFT_PROVIDER=openai
# VOICE_DRAFT_MODEL=gpt-4o-mini
# VOICE_DRAFT_BASE_URL=https://api.openai.com/v1
# Unset hides the /write panel and does not call the model.
# VOICE_DRAFTS_VISIBLE=true

# USDC unlock contract (ArticleUnlockUsdc). Defaults to mainnet deploy if unset.
# Override for forks/local; also set indexer USDC_CONTRACT_ADDRESS in Supabase.
VITE_USDC_UNLOCK_CONTRACT=0xd66Df017335ae80BcE5d4Ec728421f3a3DAf6f9f
# USDC_CONTRACT_ADDRESS=0xd66Df017335ae80BcE5d4Ec728421f3a3DAf6f9f

# WriterSubscription (Monad USDC monthly pull). Empty = first month is a USDC transfer.
# After forge script DeploySubscription.s.sol, set both:
# SUBSCRIPTION_CONTRACT=0x...
# VITE_SUBSCRIPTION_CONTRACT=0x...

# Publisher gas relayer — contract *owner* key. Writers sign for free; this wallet
# calls registerArticleFor so they don't need MON. Payments still go to the writer.
# The same key drips ~0.05 MON to readers so "Pay with USDC" does not open Coinbase
# on a 0.05 MON buy (Coinbase's minimum is ~$1 / ~45 MON).
# Transfer contract ownership to a dedicated hot wallet funded with a little MON.
# RELAYER_PRIVATE_KEY=0x...
# Optional: MONAD_RPC_URL=https://rpc.monad.xyz
# RELAYER_DAILY_LIMIT=20
# RELAYER_IP_DAILY_LIMIT=40
# RELAYER_GAS_DAILY_LIMIT=2
# RELAYER_GAS_IP_DAILY_LIMIT=30

# Optional Article NFT (ERC-1155) on Monad. Writer editions + reader receipts share this
# contract. Unlock remains access — the NFT is never required to read.
# Deploy with contracts/script/DeployArticleNft.s.sol then set (Monad mainnet):
# ARTICLE_NFT_CONTRACT=0xFe467952918F744606e70876b2af0C083D269f92
# VITE_ARTICLE_NFT_CONTRACT=0xFe467952918F744606e70876b2af0C083D269f92
# Mint auth is the connected wallet (writer/reader pays gas). Do not set a minting
# private key; RELAYER_PRIVATE_KEY is only for unlock registration / gas drips.

# Free per-writer follow (Resend). Railway web service only — not the cron service.
# Create the key at https://resend.com after verifying the sending domain
# mail.openpaywall.app (SPF, DKIM, DMARC p=none). Do not commit the key.
# Missing key: POST /api/follows/email returns 503 email_not_configured and the
# follow buttons hide the email path. Wallet follow still works.
# RESEND_API_KEY=

# HMAC key for confirm links, unsubscribe links, follower tokens, and IP hashing.
# Railway web only. Generate: openssl rand -base64 32
# FOLLOW_TOKEN_SECRET=

# Shared secret for POST /api/follows/notify/process (header x-follow-notify-secret).
# Set the SAME value in both places (do not commit the real value):
#   1. Railway web service FOLLOW_NOTIFY_SECRET
#   2. Supabase Vault, name follow_notify_secret (pg_cron reads it; see
#      supabase/migrations/0016_follow_notify_cron.sql)
# Empty never matches. Generate: openssl rand -base64 32
# FOLLOW_NOTIFY_SECRET=

# From address on the verified sending domain. Default posts@mail.openpaywall.app
# FOLLOW_EMAIL_FROM=posts@mail.openpaywall.app

# CAN-SPAM postal address for the new-post footer. Rendered from this value only.
# New-post email refuses to send when it is empty. Do not invent an address.
# POSTAL_ADDRESS=

# New-post email stays off unless this is true AND POSTAL_ADDRESS is set.
# Confirm email can still send when RESEND_API_KEY is set. Default is off.
FOLLOW_EMAILS_ENABLED=false
